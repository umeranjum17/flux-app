# Flux environment variables
# Copy this file to .env and fill in your values.

# Anthropic API key (required for Claude Code agent sessions)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (required for Codex agent sessions)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the remote-control server port (default: 19275)
# FLUX_RPC_PORT=19275
