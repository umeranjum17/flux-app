    "lucide-react": "^0.577.0",
    "openai": "^6.27.0",
    "react": "^19.2.4",
    "react-diff-viewer-continued": "^4.1.2",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "web-tree-sitter": "^0.26.6",
    "zustand": "^5.0.11"
